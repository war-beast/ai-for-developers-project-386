#!/usr/bin/env bash
# Smoke-проверка API: /health и реальные endpoint'ы типов встреч.
set -euo pipefail

PORT=5150
URL="http://127.0.0.1:${PORT}"

dotnet run --project backend/CallCalendar --no-build --urls "${URL}" &
PID=$!
trap 'kill "${PID}" 2>/dev/null || true' EXIT

ready=0
for i in $(seq 1 60); do
  if curl -fsS "${URL}/health" > /dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 1
done

if [ "${ready}" != "1" ]; then
  echo "backend did not become ready on ${URL}" >&2
  exit 1
fi

fail() {
  echo "smoke check failed: $1" >&2
  exit 1
}

status=$(curl -sS -o /dev/null -w '%{http_code}' "${URL}/api/event-types")
[ "${status}" = "200" ] || fail "GET /api/event-types returned ${status}"

slug="smoke-$(date +%s)"
body="{\"id\":\"${slug}\",\"title\":\"Smoke\",\"description\":\"Smoke check\",\"durationMinutes\":30}"

status=$(curl -sS -o /dev/null -w '%{http_code}' \
  -X POST "${URL}/api/event-types" \
  -H 'Content-Type: application/json' \
  --data "${body}")
[ "${status}" = "201" ] || fail "POST /api/event-types returned ${status}, expected 201"

status=$(curl -sS -o /dev/null -w '%{http_code}' \
  -X POST "${URL}/api/event-types" \
  -H 'Content-Type: application/json' \
  --data "${body}")
[ "${status}" = "409" ] || fail "duplicate POST returned ${status}, expected 409"

status=$(curl -sS -o /dev/null -w '%{http_code}' \
  -X POST "${URL}/api/event-types" \
  -H 'Content-Type: application/json' \
  --data '{"id":"Bad Slug","title":"","description":"","durationMinutes":20}')
[ "${status}" = "400" ] || fail "invalid POST returned ${status}, expected 400"

curl -fsS "${URL}/api/event-types" | grep -q "\"${slug}\"" \
  || fail "created type ${slug} is missing from GET /api/event-types"
