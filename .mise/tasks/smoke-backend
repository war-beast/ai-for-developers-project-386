#!/usr/bin/env bash
# Дымовой прогон: поднимает бекенд, ждёт готовности, гоняет тесты фронтенда, гасит бекенд.
set -euo pipefail

PORT=5150
URL="http://127.0.0.1:${PORT}"

dotnet run --project src/CallCalendar --no-build --urls "${URL}" &
PID=$!
trap 'kill "${PID}" 2>/dev/null || true' EXIT

ready=0
for i in $(seq 1 60); do
  if curl -fsS "${URL}/api/calendar/slots" > /dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 1
done

if [ "${ready}" != "1" ]; then
  echo "backend did not become ready on ${URL}" >&2
  exit 1
fi

SMOKE_URL="${URL}" pnpm --dir frontend test
